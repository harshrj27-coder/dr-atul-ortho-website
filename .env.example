# Copy this file to .env.local and fill in your real values.
# Nothing here is required to run the site in mock mode — booking/newsletter
# forms will work locally and log to console until you connect Supabase.

# --- Supabase (appointments, newsletter signups) ---
# Get these from your Supabase project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google Maps embed (optional — the free iframe embed works without a key) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google Calendar sync (optional, for real slot availability) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=

# --- Cloudinary (optional, for uploaded gallery/before-after images) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment gateway (optional, for paid online consultations) ---
# Add your Razorpay/Stripe keys here once you pick a provider.
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# --- AI Symptom Checker upgrade (optional) ---
# The symptom checker ships with a rule-based engine that needs no key.
# To upgrade it to a real LLM, add an Anthropic API key and wire it into
# src/app/api/symptom-check/route.ts (see comments in that file).
ANTHROPIC_API_KEY=

# --- Site basics ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLINIC_WHATSAPP_NUMBER=
CLINIC_PHONE_NUMBER=
CLINIC_EMERGENCY_NUMBER=
